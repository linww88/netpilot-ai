# 复制本文件为 .env 并填入你的真实 Key

# DeepSeek 官方接口（默认）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 若改用 OpenAI 官方接口，取消下面注释并配置 config/config.yaml 的 provider
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 若改用其他 OpenAI 兼容服务，使用自定义环境变量名（与 config.yaml 的 api_key_env 对应）
# COMPATIBLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
